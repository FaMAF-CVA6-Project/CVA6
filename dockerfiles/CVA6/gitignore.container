# What a run writes inside this container, and what the image adds on top of
# CVA6. The image carries no git history, so this matters once a repository is
# made here, and until then it is a list of what a run leaves behind.

# Run output. results/ is where the drivers put what is worth keeping.
results/
verif/sim/out_*
work-ver/

# What the harness leaves beside the simulator on every run.
verif/sim/*.dasm
verif/sim/*.trace
verif/sim/logfile.log
verif/sim/uvm_seed.log

# Waveforms and the listings that go with them. Up to about 63 KB of VCD per
# simulated cycle, so these are the large ones.
*.vcd
*.vcd.*
*.fst
*.list

# Python, and the upstream copies scripts/patch_vcd_window.py keeps.
__pycache__/
*.pyc
*.upstream

# What this project adds on top of CVA6, listed so a git status in a repository
# made here shows changed core sources rather than the image's tooling.
scripts/
CVA6_configs/
benchmarks/
CVA6Flow/
