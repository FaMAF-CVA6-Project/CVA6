+/*
+ * HPDcachePLRU: a transcription of the CVA6 HPDcache victim policy
+ * (hpdcache_victim_plru.sv, read in full) as a gem5 replacement
+ * policy. The policy is bit-PLRU with a four-tier prioritised victim
+ * cascade, and every behaviour below carries a V-rule number plus its
+ * RTL line citation. There are no tunable parameters: num_ways proxies
+ * the cache associativity.
+ *
+ *   V1  one use bit per way per set, reset all zero
+ *       (hpdcache_victim_plru.sv lines 62, 137 to 138)
+ *   V2  update sets the accessed way's bit, saturating to only that
+ *       bit when all would be one (lines 120 to 129)
+ *   V3  victim cascade, lowest way first per tier: invalid, then
+ *       zero-bit, then clean, then dirty, fetching ways excluded
+ *       from every tier (lines 72 to 115)
+ *   V4  updates pulse on stage-1 hits (hpdcache_ctrl_pe.sv lines 883
+ *       and 947) and on refill (hpdcache_miss_handler.sv lines 431
+ *       to 436 and 461 to 466), never at miss allocation, which is
+ *       why reset() below is a no-op
+ *
+ * Designed for the CVA6 lab configuration: it requires cache blocks
+ * as candidates and the evict-at-allocate discipline, where insertion
+ * happens at miss time (reset, silent) and the refill update arrives
+ * through the BaseTags::replTouch hook.
+ */
+
+#ifndef __MEM_CACHE_REPLACEMENT_POLICIES_HPDCACHE_PLRU_RP_HH__
+#define __MEM_CACHE_REPLACEMENT_POLICIES_HPDCACHE_PLRU_RP_HH__
+
+#include <memory>
+#include <vector>
+
+#include "mem/cache/replacement_policies/base.hh"
+#include "params/HPDcachePLRURP.hh"
+
+namespace gem5
+{
+
+namespace replacement_policy
+{
+
+class HPDcachePLRU : public Base
+{
+  protected:
+    /** Shared per-set use-bit vector, rule V1. */
+    struct PLRUBits
+    {
+        std::vector<bool> bits;
+        PLRUBits(uint64_t num_ways) : bits(num_ways, false) {}
+    };
+
+    /** Per-entry data: the way index and the set's shared bits. */
+    struct HPDcacheReplData : ReplacementData
+    {
+        const uint64_t index;
+        std::shared_ptr<PLRUBits> bits;
+
+        HPDcacheReplData(uint64_t index, std::shared_ptr<PLRUBits> bits)
+            : index(index), bits(bits)
+        {
+        }
+    };
+
+    /** Ways per set, proxied from the cache associativity. */
+    const uint64_t numWays;
+
+    /** Entries handed out so far, drives the per-set sharing. */
+    uint64_t count;
+
+    /** The bit vector currently being shared out. */
+    std::shared_ptr<PLRUBits> sharedBits;
+
+  public:
+    typedef HPDcachePLRURPParams Params;
+    HPDcachePLRU(const Params &p);
+    ~HPDcachePLRU() = default;
+
+    /** No-op by transcription: the RTL never clears a use bit on
+     * invalidation (V2 is the only writer), and tier 1 of V3 makes any stale
+     * bit on an invalid way unreachable. */
+    void invalidate(const std::shared_ptr<ReplacementData>&
+        replacement_data) override;
+
+    /** Rule V2: set the way's bit, saturating to only this way. */
+    void touch(const std::shared_ptr<ReplacementData>&
+        replacement_data) const override;
+
+    /** No-op by transcription of rule V4: gem5 calls reset at insertion,
+     * which under evict-at-allocate is miss time, where the RTL performs no
+     * update. The refill update arrives later through replTouch. */
+    void reset(const std::shared_ptr<ReplacementData>&
+        replacement_data) const override;
+
+    /** Rule V3: the four-tier prioritised cascade. */
+    ReplaceableEntry* getVictim(
+        const ReplacementCandidates& candidates) const override;
+
+    std::shared_ptr<ReplacementData> instantiateEntry() override;
+};
+
+} // namespace replacement_policy
+} // namespace gem5
+
+#endif // __MEM_CACHE_REPLACEMENT_POLICIES_HPDCACHE_PLRU_RP_HH__
