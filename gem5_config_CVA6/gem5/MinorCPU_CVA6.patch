+/*
+ * HPDcacheRandom: transcription of the CVA6 HPDcache victim policy
+ * that the build actually configures, hpdcache_victim_random.sv
+ * (HPDCACHE_VICTIM_RANDOM, the generate branch selected by the
+ * running configuration).
+ *
+ * The policy keeps no per-way state at all: the RTL marks every
+ * update port unused. Victim selection is a four-tier prioritised
+ * cascade (hpdcache_victim_random.sv lines 68 to 125):
+ *
+ *   R1  first invalid, non-fetching way (priority encoder, lowest
+ *       way first)
+ *   R2  the way named by a global 8-bit LFSR, if that way is valid
+ *       and not fetching
+ *   R3  else the first clean way
+ *   R4  else the first dirty way
+ *
+ *   R5  one LFSR for the whole cache, Galois right-shift, polynomial
+ *       0xE1, reset value all ones (hpdcache_lfsr.sv lines 50 and
+ *       63 to 82), shifting exactly when a selection occurs, the
+ *       unused tier did not fire, and the LFSR-named way was
+ *       eligible (shift_i gating, hpdcache_victim_random.sv line 79)
+ *
+ * There are no tunable parameters: the polynomial and seed are
+ * transcription constants. Designed for the CVA6 lab configuration
+ * under evict-at-allocate, where fetching maps to the reserved
+ * valid-but-not-readable transient and selection happens at miss
+ * time as in the RTL.
+ */
+
+#ifndef __MEM_CACHE_REPLACEMENT_POLICIES_HPDCACHE_RANDOM_RP_HH__
+#define __MEM_CACHE_REPLACEMENT_POLICIES_HPDCACHE_RANDOM_RP_HH__
+
+#include <cstdint>
+
+#include "mem/cache/replacement_policies/base.hh"
+#include "params/HPDcacheRandomRP.hh"
+
+namespace gem5
+{
+
+namespace replacement_policy
+{
+
+class HPDcacheRandom : public Base
+{
+  protected:
+    /** Per-entry data is empty: the RTL keeps no per-way state. */
+    struct HPDcacheRandomReplData : ReplacementData
+    {
+    };
+
+    /** The single global LFSR (rule R5). Mutable because getVictim is const
+     * in the base interface while a selection can shift the register,
+     * exactly as in hardware. */
+    mutable uint8_t lfsr;
+
+  public:
+    typedef HPDcacheRandomRPParams Params;
+    HPDcacheRandom(const Params &p);
+    ~HPDcacheRandom() = default;
+
+    /** No-op: the RTL update ports are unused. */
+    void invalidate(const std::shared_ptr<ReplacementData>&
+        replacement_data) override;
+
+    /** No-op: the RTL update ports are unused. */
+    void touch(const std::shared_ptr<ReplacementData>&
+        replacement_data) const override;
+
+    /** No-op: the RTL update ports are unused. */
+    void reset(const std::shared_ptr<ReplacementData>&
+        replacement_data) const override;
+
+    /** Rules R1 to R5. */
+    ReplaceableEntry* getVictim(
+        const ReplacementCandidates& candidates) const override;
+
+    std::shared_ptr<ReplacementData> instantiateEntry() override;
+};
+
