+/* CVA6IcacheRandom implementation. See cva6_icache_random_rp.hh for the
+ * rule set. The candidate downcast mirrors the one BaseSetAssoc performs
+ * on its own victim (base_set_assoc.hh line 186). */
+
+#include "mem/cache/replacement_policies/cva6_icache_random_rp.hh"
+
+#include <cassert>
+
+#include "base/intmath.hh"
+#include "base/logging.hh"
+
+#include "mem/cache/cache_blk.hh"
+
+namespace gem5
+{
+
+namespace replacement_policy
+{
+
+CVA6IcacheRandom::CVA6IcacheRandom(const Params &p)
+    : Base(p),
+      // Rule I5: lfsr.sv defaults RstVal to all ones and the icache
+      // does not override it (cva6_icache.sv lines 409 to 417).
+      lfsr(0xFF)
+{
+}
+
+void
+CVA6IcacheRandom::invalidate(
+    const std::shared_ptr<ReplacementData>& replacement_data)
+{
+}
+
+void
+CVA6IcacheRandom::touch(
+    const std::shared_ptr<ReplacementData>& replacement_data) const
+{
+}
+
+void
+CVA6IcacheRandom::reset(
+    const std::shared_ptr<ReplacementData>& replacement_data) const
+{
+}
+
+ReplaceableEntry*
+CVA6IcacheRandom::getVictim(const ReplacementCandidates& candidates) const
+{
+    assert(candidates.size() > 0);
+    const int ways = candidates.size();
+
+    // Rule I4: the way index is the low ICACHE_SET_ASSOC_WIDTH bits of
+    // the register, so the associativity must be a power of two, as it
+    // is on the D side for the same reason.
+    fatal_if(!isPowerOf2(ways),
+             "CVA6IcacheRandom needs a power-of-two associativity, got "
+             "%d. The transcribed policy takes LFSR bits directly as a "
+             "way index, as the RTL does.", ways);
+
+    // Rule I2: the lowest-index invalid way, which is what the
+    // leading-zero count over the inverted valid vector produces, and
+    // whose empty flag is all_ways_valid.
+    for (int w = 0; w < ways; w++) {
+        CacheBlk *blk = static_cast<CacheBlk*>(candidates[w]);
+        if (!blk->isValid()) {
+            // Rule I3: all_ways_valid is false here, so the register
+            // does not advance.
+            return candidates[w];
+        }
+    }
+
+    // Rule I1: every way is valid, so the register names the victim,
+    // and rule I3 advances it because this selection will be followed
+    // by a fill into a full set.
+    const int victim = lfsr & (ways - 1);
+
+    // Rule I5, lfsr.sv line 237: Galois right shift with Masks[8].
+    const uint8_t lsb = lfsr & 0x1;
+    lfsr = lfsr >> 1;
+    if (lsb) {
+        lfsr ^= 0xFA;
+    }
+
+    return candidates[victim];
+}
+
+std::shared_ptr<ReplacementData>
+CVA6IcacheRandom::instantiateEntry()
+{
+    return std::shared_ptr<ReplacementData>(new CVA6IcacheRandomReplData());
+}
+
