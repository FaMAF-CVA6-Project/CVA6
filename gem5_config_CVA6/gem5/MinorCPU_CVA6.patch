+/*
+ * CVA6IcacheRandom: a transcription of the CVA6 instruction cache
+ * replacement policy (cva6_icache.sv) for gem5.
+ *
+ * The instruction cache is a different module from the HPDcache and
+ * carries its own policy, so this is not the D-side random policy with
+ * a parameter changed. Two tiers rather than four, because the cache
+ * is read only and has no dirty state, and a different LFSR: the
+ * icache instantiates PULP's common-cells lfsr, not hpdcache_lfsr, and
+ * the two use different polynomials.
+ *
+ * Transcribed rules, with their citations:
+ *
+ *   I1  repl_way = all_ways_valid ? rnd_way : inv_way
+ *       (cva6_icache.sv line 391)
+ *   I2  inv_way is the lowest-index invalid way, from a leading-zero
+ *       count over the inverted valid vector, whose empty flag is
+ *       all_ways_valid (lines 399 to 406)
+ *   I3  update_lfsr = cache_wren & all_ways_valid (line 390), so the
+ *       register advances only on a fill into a set that was already
+ *       full. Never on a hit, and never while the set still has an
+ *       invalid way, so it does not move at all during warmup
+ *   I4  the LFSR is 8 bits wide with an output width of
+ *       ICACHE_SET_ASSOC_WIDTH (lines 409 to 417)
+ *   I5  lfsr.sv line 237: Galois right shift, next = (v >> 1) xor
+ *       (mask if the low bit is set), with Masks[8] = 0xFA and the
+ *       default reset value of all ones, and out_o = lfsr_q[OutWidth-1:0]
+ *       since CipherLayers is 0 (lines 40 to 44, 236 to 237, 286)
+ *
+ * The polynomial gives a maximal 255-state period and a way
+ * distribution of 63, 64, 64, 64 over that period for a 4-way cache.
+ * There are no tunable parameters: the polynomial, the reset value and
+ * the output width are all transcription constants.
+ */
+
+#ifndef __MEM_CACHE_REPLACEMENT_POLICIES_CVA6_ICACHE_RANDOM_RP_HH__
+#define __MEM_CACHE_REPLACEMENT_POLICIES_CVA6_ICACHE_RANDOM_RP_HH__
+
+#include <cstdint>
+
+#include "mem/cache/replacement_policies/base.hh"
+#include "params/CVA6IcacheRandomRP.hh"
+
+namespace gem5
+{
+
+namespace replacement_policy
+{
+
+class CVA6IcacheRandom : public Base
+{
+  protected:
+    /** Per-entry data is empty: the RTL keeps no per-way state. */
+    struct CVA6IcacheRandomReplData : ReplacementData
+    {
+    };
+
+    /** The single LFSR, rule I5. Mutable because getVictim is const in the
+     * base interface while a selection can advance the register, exactly as
+     * in hardware. */
+    mutable uint8_t lfsr;
+
+  public:
+    typedef CVA6IcacheRandomRPParams Params;
+    CVA6IcacheRandom(const Params &p);
+    ~CVA6IcacheRandom() = default;
+
+    /** No-op: the RTL keeps no replacement state per way. */
+    void invalidate(const std::shared_ptr<ReplacementData>&
+        replacement_data) override;
+
+    /** No-op, rule I3: a hit never advances the register. */
+    void touch(const std::shared_ptr<ReplacementData>&
+        replacement_data) const override;
+
+    /** No-op: the register advances in getVictim, where the RTL
+     *  decides between the two tiers. */
+    void reset(const std::shared_ptr<ReplacementData>&
+        replacement_data) const override;
+
+    /** Rules I1 to I3. */
+    ReplaceableEntry* getVictim(
+        const ReplacementCandidates& candidates) const override;
+
+    std::shared_ptr<ReplacementData> instantiateEntry() override;
+};
+
+} // namespace replacement_policy
+} // namespace gem5
+
+#endif // __MEM_CACHE_REPLACEMENT_POLICIES_CVA6_ICACHE_RANDOM_RP_HH__
